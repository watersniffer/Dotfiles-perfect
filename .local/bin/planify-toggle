#!/usr/bin/env bash
#
# Toggle Planify. Bound to Super+P in config/hypr/hyprland.lua.
#
#   window on screen   closed
#   no window          started
#
# Why this focuses first instead of asking close() to target a window
# ------------------------------------------------------------------
# hl.dsp.window.close() takes no window selector. It closes whatever is focused,
# and -- this is the trap -- an unrecognised key in its options table is ignored
# rather than rejected. An earlier version of this script passed
# { class = "io.github.alainm23.planify" } to it, got no error, and closed an
# unrelated window instead. hl.dsp.focus() by contrast does validate its keys, and
# hl.dsp.focus({ window = "address:0x..." }) does move focus to that exact window.
# So the window is focused by address first.
#
# Why there is a guard before the close
# ------------------------------------
# Because close() cannot be told which window to close, a failed focus would
# otherwise fall through and close whatever happened to be focused -- which is
# how an unrelated window got closed the first time. So focus is confirmed
# against hyprctl's own idea of the active window, and if it did not land, this
# script closes nothing and says so. Worst case is a message, never a wrong
# window. If you ever see that message, the likely cause is Planify sitting on a
# different workspace from the one you are on.
#
# Why jq rather than grepping hyprctl's text output
# -------------------------------------------------
# The text output includes titles as well as classes, so a task titled with the
# app id would read as "already open". jq reads the field. jq is already a
# dependency of the Super+Alt+Print bind.
set -euo pipefail

class="io.github.alainm23.planify"

read -r addr ws <<<"$(
    hyprctl -j clients 2>/dev/null |
        jq -r --arg c "$class" '
            map(select(.class == $c or .initialClass == $c)) | first
            | if . == null then "" else "\(.address) \(.workspace.id)" end'
)"

if [[ -z "$addr" ]]; then
    # No window, so there is nothing to close.
    #
    # gtk-launch, not the binary directly, and this matters more than it looks.
    # Closing Planify's window does NOT end the process: it stays alive with no
    # window, which is the normal state after a close. Running the binary then
    # hands the request to that instance, which has no window to present, so the
    # press silently did nothing and the key looked like it could only close.
    # gtk-launch goes through GDesktopAppInfo and re-presents the window on the
    # instance that is already running.
    setsid gtk-launch "$class" >/dev/null 2>&1 &
    exit 0
fi

# class: selectors proved unreliable here (one of them moved focus to Planify
# while asking for Firefox), so the address is used instead: it is exact and it
# survives the window being renamed.
hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || true
sleep 0.4

active_ws=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.id // -1')
focused=$(hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty')

# Both conditions have to hold. activewindow alone is not enough: it keeps
# reporting the last-focused window even when that window is on another
# workspace, so it can name Planify while the keyboard focus is really on some
# other window. That is the case that would let the close below land on the
# wrong window, so the workspace has to agree as well.
if [[ "$focused" != "$addr" || "$active_ws" != "$ws" ]]; then
    echo "planify-toggle: focus did not land on Planify; closing nothing." >&2
    echo "  wanted $addr on workspace $ws, focus is ${focused:-none} on workspace $active_ws." >&2
    echo "  If Planify is on another workspace, switch to it and press the key again." >&2
    exit 1
fi

hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
