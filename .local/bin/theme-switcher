local acc   = "$(c blue)"

local hl = function(name, fgval, opt)
  vim.api.nvim_set_hl(0, name, vim.tbl_extend("force", { fg = fgval }, opt or {}))
end

-- base surfaces
hl("Normal",        fg,  { bg = bg })
