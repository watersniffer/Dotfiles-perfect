hl("Parameter",     fg1)

-- status / messages
hl("LineNr",        bg3)
hl("CursorLineNr",  fg1)
hl("CursorLineSign", bg3)
hl("SignColumnSB",  bg1)
hl("Folded",        dim, { bg = bg1 })
hl("FoldColumn",    bg3)
hl("Pmenu",         fg,  { bg = bg2 })
