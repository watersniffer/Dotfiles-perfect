#!/usr/bin/env bash
#
# theme-switcher -- one palette, applied everywhere.
#
# Reads a palette from ~/.config/theme-switcher/themes/<name>.json and renders it
# into every config that can be coloured on this machine, then nudges the apps
# that can pick their new colours up live.
#
#   theme-switcher                 # rofi picker
#   theme-switcher --list
#   theme-switcher --current
#   theme-switcher catppuccin-mocha
#   theme-switcher --set monochrome --no-reload
#   theme-switcher --preview monochrome
#
# Design notes worth knowing before editing:
#
#  * Palettes are data, not templates. Adding a theme means dropping a JSON file
#    in themes/; adding an app means adding a render_* function below. The two
#    are independent.
#
#  * Nothing is written that did not change (see write_file in lib/common.sh).
#    Re-running the switcher for the theme that is already active is a no-op and
#    costs nothing, which is what makes it safe to call from a keybind.
#
#  * Apps whose config cannot be fully generated (hyprlock, rofi's icon-theme
#    line) are edited with a targeted sed rather than replaced, so hand-written
#    comments and layout survive.
#
#  * Hyprland's config is Lua, not the usual .conf. There is no "source=" for a
#    colour file, so this writes a small Lua table that hyprland.lua dofile()s,
#    and the switcher finishes with `hyprctl reload`. hl.on("hyprland.start")
#    does not re-fire on reload, so autostart is not restarted.

set -euo pipefail

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Allow running straight from a checkout as well as from ~/.local/bin.
if [[ -d "$SELF_DIR/../.config/theme-switcher/lib" ]]; then
	THEME_DIR="$(cd -- "$SELF_DIR/../.config/theme-switcher" && pwd)"
else
	THEME_DIR="$HOME/.config/theme-switcher"
fi
export THEME_DIR

# shellcheck source=lib/common.sh
source "$THEME_DIR/lib/common.sh"

RELOAD=1
DRY_RUN=0
declare -a CHANGED=()

# =============================================================== ui helpers ==

if [[ -t 1 ]]; then
	G=$'\033[32m'; B=$'\033[34m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'; D=$'\033[2m'
else
	G=''; B=''; Y=''; R=''; N=''; D=''
fi

banner() {
	printf '\n%s  %s -> %s%s\n' "${B}◆ theme${N}" "${D}${2:-}${N}" "$1" >&2
	if [[ -n "${2:-}" && "${2}" != "$1" ]]; then
		printf '%s  %s%s\n' "${D}  previously: $2${N}" >&2
	fi
}

emit() { # emit <label> <path> [mode]   -- content on stdin
	local label="$1" path="$2" mode="${3:-0644}"

	# Guard the argument contract. An unquoted two-word label shifts path and
	# mode along by one, and write_file will then cheerfully create a file named
	# after the second label in $HOME instead of writing the config tree. Both
	# arguments are checked so that mistake fails loudly instead of silently.
	[[ "$path" == /* ]] || die "emit: path must be absolute, got '$path' (label: '$label')"
	[[ "$mode" =~ ^[0-7]{3,4}$ ]] || die "emit: mode must be octal, got '$mode' (label: '$label')"

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would write $label -> $path"
		return 0
	fi
	if write_file "$path" "$mode"; then
		CHANGED+=("$label")
		log "  ${G}✓${_c_off} $label"
	else
		log "  ${D}· $label (unchanged)${_c_off}"
	fi
}

# Append a delimited block to a hand-maintained stylesheet, replacing any block
# from a previous run. Appending (rather than rewriting) means the hand-written
# structure and its comments are never at risk, and CSS cascade order does the
# overriding for us: these rules come last, so they win on equal specificity.
emit_css_block() { # emit_css_block <path> <marker>   -- content on stdin
	local path="$1" marker="$2" tmp
	((DRY_RUN)) && { log "${_c_dim}dry-run${_c_off} would append block to $path"; return 0; }

	# Create the file if it is not there yet. Firefox's userChrome.css does not
	# exist on a fresh profile, and refusing to write it there would mean the
	# browser silently stays unthemed. For swaync and wlogout the file is always
	# already present, so this only ever fires for a genuinely missing file.
	if [[ ! -f "$path" ]]; then
		if ((DRY_RUN)); then
			log "${_c_dim}dry-run${_c_off} would create $path"
			return 0
		fi
		mkdir -p "$(dirname "$path")"
		printf '/* %s: generated by theme-switcher. Colours live in the marked block below. */\n' \
			"$marker" >"$path"
	fi

	local body; body="$(cat)"
	local tmp; tmp="$(mktemp)"

	# Drop whatever this marker wrote last time, keep everything else, then
	# append the fresh block. Two details matter here:
#
	#  * The match is on the `/* <marker>:begin` prefix, not the whole line, so
	#    the descriptive suffix is free to change without orphaning blocks.
	#  * Trailing blank lines are squeezed off the host file before appending.
	#    Without that, each run leaves the previous run's separating blank line
	#    behind and the file grows by one blank line per switch.
	awk -v m="$marker" '
		$0 ~ ("^/\\* " m ":begin") { skip = 1 }
		!skip                     { print }
		$0 ~ ("^/\\* " m ":end")   { skip = 0 }
	' "$path" \
		| awk '{ l[NR] = $0 } END { n = NR; while (n > 0 && l[n] ~ /^[ \t]*$/) n--; for (i = 1; i <= n; i++) print l[i] }' \
		>"$tmp"

	# Same for the leading blanks of the body, for symmetry.
	body="$(printf '%s\n' "$body" | sed '/./,$!d')"

	{
		printf '\n/* %s:begin -- generated by theme-switcher, edits inside are overwritten */\n' "$marker"
		printf '%s\n' "$body"
		printf '/* %s:end -- generated by theme-switcher, safe to delete this whole block */\n' "$marker"
	} >>"$tmp"

	# Always return 0, including for "unchanged": renderers run under `set -e`
	# and an unchanged block is the normal case when re-applying a theme.
	if cmp -s "$tmp" "$path"; then
		rm -f "$tmp"
		log "  ${D}· $(basename "$(dirname "$path")")/$(basename "$path") block (unchanged)${_c_off}"
		return 0
	fi
	cat "$tmp" >"$path"
	rm -f "$tmp"
	local label; label="$(basename "$(dirname "$path")")/$(basename "$path")"
	CHANGED+=("$label")
	log "  ${G}✓${_c_off} $label css block"
	return 0
}

# =============================================================== renderers ==

# --- Hyprland ----------------------------------------------------------
# hyprland.lua dofiles this. A Lua table, because the compositor config is Lua
# and there is no way to `source =` a colour file into it otherwise.
render_hypr() {
	# Hyprland's rgba() takes hex channel pairs plus a hex alpha suffix, e.g.
	# rgba(cba6f7ff) -- and notably *without* a leading '#', unlike every other
	# format this script emits. Both mistakes here are silent failures that
	# leave the option unset rather than raising: rgba(203,166,247ff) is the
	# decimal form and is rejected, and so is rgba(#cba6f7ff) for the '#'.
	# Hence hex_only() rather than c() or hex2rgb_commas.
	local active_c i_c shadow
	active_c="$(hex_only "$(c border_active)")ff"
	i_c="$(hex_only "$(c border_inactive)")ff"
	shadow="0xee1a1a1a"

	# Validate before writing. A wrong colour here does not raise anything
	# visible: Hyprland reports it as a config error after the fact and carries
	# on with the border unset, so the only way to notice is to check the
	# running compositor afterwards. Checking the string here turns that into an
	# immediate, obvious failure.
	[[ "$active_c" =~ ^[0-9a-f]{8}$ ]] || die "render_hypr: active border colour '$active_c' is not 8 hex digits"
	[[ "$i_c" =~ ^[0-9a-f]{8}$ ]] || die "render_hypr: inactive border colour '$i_c' is not 8 hex digits"

	emit "hyprland theme" "$HOME/.config/hypr/theme.lua" <<EOF
-- Generated by theme-switcher -- do not edit.
-- Read by hyprland.lua via dofile(), so `hyprctl reload` alone picks up a theme change.

return {
	name = "$(jq -r '.name' "$CURRENT_PALETTE_FILE")",
	label = "$THEME_LABEL",

	active_border = "rgba($active_c)",
	inactive_border = "rgba($i_c)",

	shadow_color = "$shadow",
}
EOF
}

# --- Waybar ------------------------------------------------------------
# style.css already does `@import url("colors.css")`, so only the palette is
# rewritten and the 11 KB of layout CSS is never touched.
render_waybar() {
	emit "waybar colors.css" "$HOME/.config/waybar/colors.css" <<EOF
/* $THEME_LABEL -- generated by theme-switcher from
   ~/.config/theme-switcher/themes/$(jq -r '.name' "$CURRENT_PALETTE_FILE").json
   Do not edit; re-running \`theme-switcher\` overwrites this file. */

@define-color base         $(c base);
@define-color bg1          $(c bg1);
@define-color bg2          $(c bg2);
@define-color bg3          $(c bg3);
@define-color bg4          $(c bg4);
@define-color bg           $(c bg1);
@define-color text         $(c fg);
@define-color fg           $(c fg);
@define-color subtext      $(c subtext);
@define-color overlay2     $(c overlay2);
@define-color overlay0     $(c overlay0);
@define-color ws_inactive  $(c ws_inactive);
@define-color ws_active    $(c ws_active);
@define-color urgent       $(c urgent);
@define-color tooltip_bg   $(c base);
@define-color tooltip_border $(c bg3);
@define-color battery_warn $(c battery_warn);
@define-color battery_crit $(c battery_crit);
@define-color cpucat       $(c cpucat);

/* bar surface: transparent bar, islands paint these (alpha baked in) */
@define-color island        $(rgba base island);
@define-color island_hover  $(hex2rgba "$(c bg2)" "$(a island_hover)");
EOF
}

# --- Rofi --------------------------------------------------------------
# config.rasi imports this and references only these names, so config.rasi
# itself never has to be rewritten. The alpha here is deliberately the same
# value the bar's islands use, so the launcher and the bar are one surface.
render_rofi() {
	emit "rofi colors.rasi" "$HOME/.config/rofi/colors.rasi" <<EOF
/* $THEME_LABEL -- generated by theme-switcher. config.rasi imports this and
   references only these names, so it never has to be rewritten when the theme
   changes. */

* {
    bg0     : $(c bg0);
    bg1     : $(c bg1);
    bg2     : $(c bg2);
    bg3     : $(c bg3);

    fg0     : $(c fg0);
    fg1     : $(c fg1);
    fg2     : $(c fg2);

    red     : $(c red);
    green   : $(c green);
    yellow  : $(c yellow);
    blue    : $(c blue);
    magenta : $(c magenta);
    cyan    : $(c cyan);
    orange  : $(c orange);

    accent  : $(c accent);
    urgent  : $(c destructive);

    windowBg  : $(rgba base surface);
    surfaceBg : $(rgba base surface);
    borderSoft : $(hex2rgba "$(c border_soft)" "$(a border_soft)");
    selectedBg : $(c bg3);
    onSelected : $(c fg0);
    onUrgent   : $(c base);
}
EOF

	# icon-theme lives inside configuration{} in config.rasi, which rasi cannot
	# template, so this one line is patched in place. The trailing semicolon is
	# part of rasi's syntax and has to be put back explicitly.
	local icon="${APP[icon_theme]}"
	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would set rofi icon-theme -> $icon"
	elif sed_file "$HOME/.config/rofi/config.rasi" \
		-e "s|^\([[:space:]]*icon-theme:[[:space:]]*\).*;[[:space:]]*$|\1\"$icon\";|" ; then
		CHANGED+=("rofi icon-theme")
		log "  ${G}✓${_c_off} rofi icon-theme -> $icon"
	fi
}

# --- Kitty -------------------------------------------------------------
# kitty.conf `include`s current-theme.conf, so existing terminals pick the new
# colours up when `kitty @ set-colors` is run at the end.
#
# The colour0..17 mapping is deliberately uniform across themes: c0/c8 are two
# steps of the neutral ramp, c1..c7 are the seven hue roles, c9..c15 the same
# seven with the brightest text, c16/c17 two steps of the dim text ramp.
render_kitty() {
	emit "kitty theme" "$HOME/.config/kitty/current-theme.conf" <<EOF
# vim:ft=kitty
# $THEME_LABEL -- generated by theme-switcher. Included by kitty.conf.

background                $(c base)
foreground                $(c fg)
selection_background      $(c bg4)
selection_foreground      $(c fg)
url_color                 $(c blue)
cursor                    $(c fg)
cursor_text_color         $(c base)

# Tabs
active_tab_background     $(c fg)
active_tab_foreground     $(c base)
inactive_tab_background   $(c bg2)
inactive_tab_foreground   $(c subtext)

# Windows
active_border_color       $(c fg)
inactive_border_color     $(c bg3)

# Marks
mark1_background          $(c fg)
mark2_background          $(c blue)
mark3_background          $(c green)

# Normal
color0  $(c bg3)
color1  $(c red)
color2  $(c green)
color3  $(c yellow)
color4  $(c blue)
color5  $(c magenta)
color6  $(c cyan)
color7  $(c fg1)
color8  $(c bg4)

# Bright
color9  $(c red)
color10 $(c green)
color11 $(c yellow)
color12 $(c blue)
color13 $(c magenta)
color14 $(c cyan)
color15 $(c fg)

# Extended
color16 $(c overlay0)
color17 $(c fg1)
EOF
}

# --- GTK 3 / GTK 4 / libadwaita ---------------------------------------
# One file, written to both version dirs. GTK4 and libadwaita read it natively;
# GTK3 gets it through gtk.css, which already has @import url("colors.css").
#
# accent_color is accent2 rather than accent on purpose. GTK's accent_color is
# what colours selected/checked rows, and on gruvbox that has always been the
# orange #fe8019 while the theme's `accent` role is the warm foreground. For the
# other two themes accent2 is the single hue that should mark selection, which
# is the same reason they define it that way.
render_gtk() {
	local f
	for f in "$HOME/.config/gtk-3.0/colors.css" "$HOME/.config/gtk-4.0/colors.css"; do
		emit "$(basename "$(dirname "$f")")/colors.css" "$f" <<EOF
/* $THEME_LABEL -- generated by theme-switcher. Read natively by GTK4 and
   libadwaita; pulled into GTK3 by ~/.config/gtk-3.0/gtk.css. */

@define-color accent_bg_color $(c bg3);
@define-color accent_color $(c accent2);
@define-color accent_fg_color $(c on_accent);

@define-color window_bg_color $(c base);
@define-color window_fg_color $(c fg);

@define-color view_bg_color $(c bg1);
@define-color view_fg_color $(c fg);

@define-color headerbar_bg_color $(c bg1);
@define-color headerbar_fg_color $(c fg);

@define-color card_bg_color $(c bg2);
@define-color card_fg_color $(c fg);

@define-color popover_bg_color $(c bg1);
@define-color popover_fg_color $(c fg);

@define-color dialog_bg_color $(c bg2);
@define-color dialog_fg_color $(c fg);

@define-color sidebar_bg_color $(c bg1);
@define-color sidebar_fg_color $(c fg);

@define-color destructive_bg_color $(c destructive);
@define-color destructive_fg_color $(c on_accent);
@define-color destructive_color $(c destructive);

@define-color error_bg_color $(c error);
@define-color error_fg_color $(c on_accent);
@define-color error_color $(c error);

@define-color success_bg_color $(c success);
@define-color success_fg_color $(c on_accent);
@define-color success_color $(c success);

@define-color warning_bg_color $(c warning);
@define-color warning_fg_color $(c on_accent);
@define-color warning_color $(c warning);
EOF
	done
}

# --- Qt 6 / Qt 5 -------------------------------------------------------
#
# qt6ct's palette is a fixed 21-slot vector, not a set of named roles, and the
# slot order below was read off qt6ct's own shipped schemes in
# /usr/share/qt{5,6}ct/colors/. Both qt6ct and qt5ct configs are written: the
# compositor sets QT_QPA_PLATFORMTHEME=qt6ct for the Qt6 apps, and the qt5ct
# config is there for Qt5 apps (Krita) either via qt5ct or via Kvantum.
#
# Slot 21 is Qt's 21st role which qt6ct writes as the previous slot at 50%
# alpha; the shipped schemes all do that, so this does too.
render_qt() {
	local slots=(
		"$(c fg)"         #  1 WindowText
		"$(c base)"       #  2 Button
		"$(c fg_bright)"  #  3 Light
		"$(c bg2)"        #  4 Midlight
		"$(c base)"       #  5 Dark
		"$(c bg1)"        #  6 Mid
		"$(c fg)"         #  7 Text
		"$(c fg_bright)"  #  8 BrightText
		"$(c fg)"         #  9 ButtonText
		"$(c bg2)"        # 10 Base
		"$(c base)"       # 11 Window
		"$(c bg2)"        # 12 ToolTipBase
		"$(c fg)"         # 13 ToolTipText
		"$(c accent)"     # 14 Highlight
		"$(c on_accent)"  # 15 HighlightedText
		"$(c blue)"       # 16 Link
		"$(c magenta)"    # 17 LinkVisited
		"$(c bg3)"        # 18 AlternateBase
		"$(c bg2)"        # 19 NoRole
		"$(c fg2)"        # 20 PlaceholderText
	)
	local joined
	joined="$(printf '%s, ' "${slots[@]}")"
	joined="${joined%, }"
	local slot21="#80${slots[19]}"

	local font="JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0"
	local -a targets=("$HOME/.config/qt6ct/qt6ct.conf" "$HOME/.config/qt5ct/qt5ct.conf")
	local f
	for f in "${targets[@]}"; do
		emit "qtct ($(basename "$(dirname "$f")"))" "$f" <<EOF
[General]
font=$font

[ColorScheme]
active_colors=$joined, $slot21
disabled_colors=$joined, $slot21
inactive_colors=$joined, $slot21

EOF
	done

	# Kvantum carries the widget chrome (frames, toolbars, menus); qt6ct
	# carries the palette inside it. Both are needed for the theme to read right.
	local kv="${APP[kvantum_theme]}"
	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would set Kvantum theme -> $kv"
	else
		if write_file "$HOME/.config/Kvantum/kvantum.kvconfig" <<EOF
; Generated by theme-switcher. Selects the Kvantum theme for every Qt app.
; Overridden per-app by ~/.config/qvdb/<app>-kvantum.kvconfig if one exists.

[%General]
theme=$kv
no_inact_fg=false
EOF
		then
			CHANGED+=("kvantum theme")
			log "  ${G}✓${_c_off} kvantum theme -> $kv"
		else
			log "  ${D}· kvantum theme (unchanged)${_c_off}"
		fi
	fi
}

# --- mako --------------------------------------------------------------
# This file is fully regenerated, including the non-colour settings, so the
# renderer owns it completely. The geometry below is verbatim from the existing
# mako/config; only the colours come from the palette.
render_mako() {
	emit "mako config" "$HOME/.config/mako/config" <<EOF
# $THEME_LABEL -- generated by theme-switcher.
# The geometry/font lines below are preserved from the previous hand-written
# config; only colours come from the palette.

font=JetBrainsMono Nerd Font 9
background-color=$(c base)
text-color=$(c fg)
border-color=$(c fg)
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
width=360
icons=1
max-icon-size=64
text-alignment=left

[urgency=low]
background-color=$(c bg1)
text-color=$(c fg2)
border-color=$(c bg2)
default-timeout=4000

[urgency=normal]
background-color=$(c base)
text-color=$(c fg)
border-color=$(c fg)
default-timeout=6000

[urgency=critical]
background-color=$(c bg1)
text-color=$(c fg)
border-color=$(c destructive)
EOF
}

# --- swaync ------------------------------------------------------------
# Two separate things have to be themed here, and getting only one of them right
# still leaves the popup looking stock.
#
# 1. swaync 0.12.6's own palette. It is all @define-color at the top of
#    /etc/xdg/swaync/style.css: cc-bg, noti-bg, noti-bg-darker, noti-bg-hover,
#    text-color and so on. Override those names and the stock layout follows.
#
# 2. The hand-written ~/.config/swaync/style.css, which is written against swaync
#    0.10's older naming and references 16 @define-color nb-* names that it
#    defines itself, hard-coded, on lines 4-19 -- to a Gruvbox palette, in every
#    theme. Those definitions are left in place as a fallback (so deleting the
#    generated block degrades to a readable popup rather than a colourless one)
#    and the same names are re-declared here, which wins by coming later in the
#    file.
#
# The previous version of this function emitted `:root { --cc-bg: ... }` and
# friends. That is dead CSS: GTK has no support for `--custom-property` values or
# var(), so none of it did anything, which is why swaync appeared not to theme at
# all. GTK's mechanism is @define-color, referenced as @name.
#
# nb-red and friends map to the acc_* roles rather than to the ANSI-ish red/green/
# blue roles. Those roles are not usable: the gruvbox palette holds a cream in
# `red` (#d5c4a1), a grey-tan in `green` and an orange in `blue`, so a close
# button bound to role `red` would come out cream. The acc_* roles were added for
# exactly this purpose and are correct in all three palettes.
render_swaync() {
	emit_css_block "$HOME/.config/swaync/style.css" "theme-switcher:swaync" <<EOF
/* swaync 0.12.6's own palette names. */
@define-color cc-bg transparent;
@define-color noti-bg $(rgba base surface);
@define-color noti-bg-opaque $(c base);
@define-color noti-bg-darker $(c bg1);
@define-color noti-bg-hover $(c bg3);
@define-color noti-bg-hover-opaque $(c bg3);
@define-color noti-bg-focus $(c bg2);
@define-color noti-close-bg $(hex2rgba "$(c fg)" 0.1);
@define-color noti-close-bg-hover $(hex2rgba "$(c fg)" 0.15);
@define-color text-color $(c fg);
@define-color text-color-disabled $(c fg2);
@define-color noti-border-color $(hex2rgba "$(c fg)" 0.18);
@define-color bg-selected $(c acc_blue);

/* The nb-* names the hand-written part of this stylesheet uses. Re-declared here
 * so they follow the theme; the originals near the top of the file stay as a
 * fallback. */
@define-color nb-bg0 $(c base);
@define-color nb-bg1 $(c bg1);
@define-color nb-bg2 $(c bg2);
@define-color nb-bg3 $(c bg3);
@define-color nb-bg4 $(c bg4);
@define-color nb-fg1 $(c fg);
@define-color nb-fg2 $(c fg1);
@define-color nb-fg4 $(c fg2);
@define-color nb-gray $(c overlay0);
@define-color nb-yellow $(c acc_yellow);
@define-color nb-orange $(c acc_orange);
@define-color nb-red $(c acc_red);
@define-color nb-green $(c acc_green);
@define-color nb-aqua $(c acc_aqua);
@define-color nb-blue $(c acc_blue);
@define-color nb-purple $(c acc_purple);

.widget-mpris > box > button:hover {
  background: $(hex2rgba "$(c bg3)" 1);
}
EOF
}

# --- wlogout -----------------------------------------------------------
# Same approach: appended block, same selectors, cascade does the work.
render_wlogout() {
	# wlogout only reads style.css at startup, so this is not live -- reload_apps
	# kills a running wlogout so the next launch picks it up.
	#
	# The state selectors are grouped exactly as the hand-written file groups
	# them, and all three are covered. Overriding only :hover left the focused
	# and active buttons on the stock #3700B3 purple, which is the whole reason
	# those rules were overridden in the first place.
	emit_css_block "$HOME/.config/wlogout/style.css" "theme-switcher:wlogout" <<EOF
window {
	background-color: $(rgba base surface);
}
button {
	color: $(c fg);
	text-decoration-color: $(c fg);
	background-color: $(c base);
	border-color: $(c bg3);
}
button:focus, button:active, button:hover {
	background-color: $(c yellow);
	color: $(c on_accent);
	border-color: $(c yellow);
}
EOF
}

# --- nwg-dock-hyprland -----------------------------------------------------
# An appended marker block, like swaync and wlogout: the dock's stylesheet is
# hand-written and this overrides the colours in it by cascade.
#
# The CSS is a plain rewrite of every coloured property rather than a small override,
# because GTK3 has no custom-property support: `--dock_bg: x;` and `var(--dock_bg)`
# are both silently ignored (the same mistake as the old swaync renderer, which is why
# that one now emits @define-color). Only real GTK3 properties here -- an unknown one
# is a FATAL parse error that takes the whole dock down, not a warning.
#
# The dock must be restarted for a change to land. It reads its CSS once at startup,
# which is the same situation as wlogout, hence the kill in reload_apps.
render_dock() {
	emit_css_block "$HOME/.config/nwg-dock-hyprland/style.css" "theme-switcher:nwg-dock" <<EOF
window {
	background: $(hex2rgba "$(c bg1)" 0.55);
	border-color: $(hex2rgba "$(c bg3)" 0.35);
}
#active {
	border-color: $(c accent);
}
button, image {
	color: $(c fg);
}
button {
	color: $(c fg);
}
button:hover {
	background-color: $(hex2rgba "$(c bg3)" 0.45);
}
EOF
}

# --- btop --------------------------------------------------------------
render_btop() {
	local name; name="$(jq -r '.name' "$CURRENT_PALETTE_FILE")"
	emit "btop theme ($name)" "$HOME/.config/btop/themes/$name.theme" <<EOF
# $THEME_LABEL -- generated by theme-switcher.
# btop matches color_theme by full path, filename or stem, so the stem is set
# in btop.conf below.

theme[main_bg]="$(c bg1)"
theme[main_fg]="$(c fg2)"

theme[title]="$(c fg)"
theme[hi_fg]="$(c yellow)"

theme[selected_bg]="$(c base)"
theme[selected_fg]="$(c yellow)"

theme[inactive_fg]="$(c bg2)"
theme[graph_text]="$(c overlay0)"

theme[proc_misc]="$(c green)"
theme[cpu_box]="$(c fg2)"
theme[mem_box]="$(c fg2)"
theme[net_box]="$(c fg2)"
theme[proc_box]="$(c fg2)"
theme[div_line]="$(c fg2)"

theme[temp_start]="$(c cyan)"
theme[temp_mid]="$(c magenta)"
theme[temp_end]="$(c red)"

theme[cpu_start]="$(c green)"
theme[cpu_mid]="$(c yellow)"
theme[cpu_end]="$(c red)"

theme[free_start]="$(mix "$(c cyan)" "$(c bg1)" 55)"
theme[free_mid]=""
theme[free_end]="$(c green)"

theme[cached_start]="$(c cyan)"
theme[cached_mid]=""
theme[cached_end]="$(c cyan)"

theme[available_start]="$(c yellow)"
theme[available_mid]=""
theme[available_end]="$(c yellow)"

theme[used_start]="$(mix "$(c red)" "$(c bg1)" 55)"
theme[used_mid]=""
theme[used_end]="$(c red)"

theme[download_start]="$(c magenta)"
theme[download_mid]="$(mix "$(c magenta)" "$(c bg1)" 45)"
theme[download_end]="$(c magenta)"

theme[upload_start]="$(mix "$(c red)" "$(c bg1)" 55)"
theme[upload_mid]="$(mix "$(c magenta)" "$(c bg1)" 45)"
theme[upload_end]="$(c magenta)"
EOF

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would point btop.conf at $name.theme"
	elif sed_file "$HOME/.config/btop/btop.conf" \
		-e "s|^\(color_theme[[:space:]]*=[[:space:]]*\).*|\1\"$name.theme\"|" ; then
		CHANGED+=("btop.conf")
		log "  ${G}✓${_c_off} btop.conf -> $name.theme"
	fi
}

# --- mpv ---------------------------------------------------------------
# There was no ~/.config/mpv at all before, so this is a new file. Keep it to
# the handful of options that are genuinely appearance and nothing else, so it
# does not silently take over a config the user later writes.
render_mpv() {
	emit "mpv config" "$HOME/.config/mpv/mpv.conf" <<EOF
# $THEME_LABEL -- generated by theme-switcher.
# Only appearance options; no input, audio or video behaviour is set here.

# Keep the OSD and the background inside the terminal's palette so mpv's
# default black never flashes against a light theme.
osd-color=$(c fg)
sub-color=$(c fg2)
background-color=$(c base)
secondary-sub-color=$(c bg2)

# Borderless by default; the window manager draws the border and themes it.
no-border=false
border-color=$(c border_active)

# Screenshot / index colours.
screenshot-format=png
screenshot-highlight-color=$(c accent)
EOF
}

# --- Neovim -----------------------------------------------------------
#
# This machine already has gruvbox.nvim, catppuccin and tokyonight.nvim on
# disk, so gruvbox and catppuccin just need LazyVim told which to load.
# `monochrome` has no upstream plugin, so the switcher writes a self-contained
# greyscale colorscheme into ~/.config/nvim/colors/ instead.
render_nvim() {
	local scheme="${APP[nvim_colorscheme]}"

	emit "nvim theme" "$HOME/.config/nvim/lua/config/theme.lua" <<EOF
-- Generated by theme-switcher -- do not edit.
-- Read by ~/.config/nvim/lua/plugins/colorscheme.lua on startup.

return {
	colorscheme = "$scheme",
	flavour = "mocha",   -- only used by catppuccin
}
EOF

	if [[ "$scheme" == "monochrome" ]]; then
		render_nvim_monochrome
	fi
}

render_nvim_monochrome() {
	emit "nvim monochrome colorscheme" "$HOME/.config/nvim/colors/monochrome.lua" <<EOF
-- Generated by theme-switcher -- do not edit.
-- Greyscale, generated from the palette rather than derived from another colorscheme
-- (which would leave that one's hues behind).

vim.g.colors_name = "monochrome"

local bg    = "$(c bg0)"
local bg1   = "$(c bg1)"
local bg2   = "$(c bg2)"
local bg3   = "$(c bg3)"
local fg    = "$(c fg)"
local fg1   = "$(c fg1)"
local fg2   = "$(c fg2)"
