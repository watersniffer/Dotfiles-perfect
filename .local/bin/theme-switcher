hl("PmenuThumb",    fg2)
hl("StatusLine",    fg1, { bg = bg1, reverse = false })
hl("StatusLineNC",  fg2, { bg = bg1 })
hl("VertSplit",     bg3)
hl("WinSeparator",  bg3)
hl("DiffText",      bg,  { bg = fg1 })
hl("DiffAdd",       fg,  { bg = bg2 })
hl("DiffChange",    fg,  { bg = bg2 })
hl("DiffDelete",    bg,  { bg = dim })
hl("DiagnosticError",   acc, { bold = true })
hl("DiagnosticWarn",    fg2, { bold = true })
hl("DiagnosticInfo",    fg2)
hl("DiagnosticHint",    fg2)
hl("DiagnosticOk",      fg2)
hl("WarningMsg",     fg2)
hl("ErrorMsg",       acc, { bold = true })
hl("MoreMsg",        fg1)
hl("Question",       fg1)
hl("Search",         bg,  { bg = fg1 })
hl("IncSearch",      bg,  { bg = acc, bold = true })
hl("CurSearch",      bg,  { bg = fg,  bold = true })
hl("Todo",           acc, { bold = true })
hl("MatchParen",     fg,  { bg = bg3, bold = true })
hl("ModeMsg",        fg1, { bold = true })
hl("MsgArea",        fg1)
hl("MsgSeparator",   bg3)
hl("SpellBad",       acc, { underline = true })
hl("SpellCap",       fg2, { underline = true })
hl("SpellLocal",     fg2, { underline = true })
hl("Title",          fg,  { bold = true })
hl("Directory",      fg)
hl("Underlined",     fg,  { underline = true })
hl("Bold",           fg,  { bold = true })
hl("Italic",         fg,  { italic = true })
hl("Strikethrough",  fg,  { strikethrough = true })
hl("Ignore",         dim)

-- treesitter
for _, g in ipairs({
  "@variable", "@variable.builtin", "@variable.parameter", "@variable.member",
  "@constant", "@constant.builtin", "@constant.macro", "@module", "@label",
  "@string", "@string.documentation", "@string.regexp", "@string.escape",
  "@character", "@number", "@boolean", "@float",
  "@function", "@function.builtin", "@function.call", "@function.macro",
  "@constructor", "@operator", "@keyword", "@keyword.function",
  "@keyword.operator", "@keyword.return", "@keyword.repeat",
  "@keyword.import", "@keyword.conditional", "@keyword.exception",
  "@punctuation.delimiter", "@punctuation.bracket", "@punctuation.special",
  "@comment", "@comment.error", "@comment.warning", "@comment.todo",
  "@markup.strong", "@markup.italic", "@markup.strikethrough",
  "@markup.underline", "@markup.heading", "@markup.math", "@markup.link",
  "@markup.link.label", "@markup.link.url", "@markup.quote",
  "@markup.list", "@markup.raw", "@diff.plus", "@diff.minus", "@diff.delta",
}) do
  local map = {
    ["@variable"] = fg, ["@variable.builtin"] = fg1, ["@variable.parameter"] = fg1,
    ["@variable.member"] = fg, ["@constant"] = fg1, ["@constant.builtin"] = acc,
    ["@constant.macro"] = acc, ["@module"] = fg, ["@label"] = fg1,
    ["@string"] = fg1, ["@string.documentation"] = fg1, ["@string.regexp"] = acc,
    ["@string.escape"] = acc, ["@character"] = fg1, ["@number"] = fg1,
    ["@boolean"] = fg1, ["@float"] = fg1, ["@function"] = fg,
    ["@function.builtin"] = fg1, ["@function.call"] = fg, ["@function.macro"] = acc,
    ["@constructor"] = fg, ["@operator"] = fg1, ["@keyword"] = fg,
    ["@keyword.function"] = fg, ["@keyword.operator"] = fg1, ["@keyword.return"] = fg,
    ["@keyword.repeat"] = fg, ["@keyword.import"] = acc, ["@keyword.conditional"] = fg,
    ["@keyword.exception"] = fg, ["@punctuation.delimiter"] = fg2,
    ["@punctuation.bracket"] = fg2, ["@punctuation.special"] = fg2,
    ["@comment"] = dim, ["@comment.error"] = dim, ["@comment.warning"] = dim,
    ["@comment.todo"] = acc, ["@markup.strong"] = fg, ["@markup.italic"] = fg,
    ["@markup.strikethrough"] = fg, ["@markup.underline"] = fg,
    ["@markup.heading"] = fg, ["@markup.math"] = fg1, ["@markup.link"] = acc,
    ["@markup.link.label"] = fg1, ["@markup.link.url"] = fg1, ["@markup.quote"] = fg2,
    ["@markup.list"] = fg2, ["@markup.raw"] = fg1, ["@diff.plus"] = fg,
    ["@diff.minus"] = fg, ["@diff.delta"] = fg,
  }
  if map[g] then hl(g, map[g]) end
end
EOF
}

# --- Firefox --------------------------------------------------------------
#
# Firefox profiles are discovered from profiles.ini rather than assumed, because
# the path is a generated name (gi38vh3m.default-release), not "default". The
# profile plain `firefox` opens is the one named Default= under an [Install...]
# section, and that is the one to theme -- the other may be an empty leftover.
#
# Two files, and they are different kinds of file:
#
#   userChrome.css   generated, between comment markers so hand edits survive
#   user.js          *appended* to, never rewritten -- it already holds the
#                    hand-set UI scale and fonts, and losing those would be a
#                    silent regression nobody would notice until the text got
#                    small again.
#
# ui.useCustomColors has to be true or Firefox ignores every custom colour in
# userChrome.css, which is why it is set alongside rather than assumed.
render_firefox() {
	local ini
	local -a candidates=()
	local f

	# XDG_CONFIG_HOME is often unset even when the app honours it, and this
	# script runs under `set -u`, so every expansion has a fallback.
	local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
	for ini in "$xdg/mozilla/firefox/profiles.ini" \
		"$HOME/.config/mozilla/firefox/profiles.ini" \
		"$HOME/.mozilla/firefox/profiles.ini"; do
		if [[ ! -f "$ini" ]]; then
			continue
		fi

		# Which profile plain `firefox` opens is Default=<path> inside an
		# [Install...] section. Note the difference from the Default=1 in a
		# [ProfileN] section, which is just a boolean "this is a profile" flag
		# and carries no path -- matching on Default=1 finds nothing.
		local section="" rel=""
		while IFS= read -r raw; do
			raw="${raw%%#*}"
			raw="$(printf '%s' "$raw" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
			if [[ -z "$raw" ]]; then
				continue
			fi
			if [[ "$raw" == "["*"]" ]]; then
				section="$raw"
				continue
			fi
			if [[ "$raw" == Path=* ]]; then
				rel="${raw#Path=}"
				continue
			fi
			if [[ "$section" == \[Install* && "$raw" == Default=* ]]; then
				local d="${raw#Default=}"
				if [[ -n "$d" && "$d" != "1" ]]; then
					candidates+=("$d")
				fi
			fi
		done <"$ini"

		# Fall back to any profile that actually has a prefs.js, so a hand-edited
		# or renamed profiles.ini still resolves to something real.
		if ((${#candidates[@]} == 0)); then
			local d
			while IFS= read -r d; do
				if [[ -f "$d/prefs.js" ]]; then
					candidates+=("$d")
				fi
			done < <(find "$(dirname "$ini")" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
		fi
		break
	done

	local profile_dir="" root
	root="$(dirname "$ini")"
	for f in "${candidates[@]}"; do
		case "$f" in
			/*) profile_dir="$f" ;;
			*)  profile_dir="$root/$f" ;;
		esac
		if [[ -d "$profile_dir" ]]; then
			break
		fi
		profile_dir=""
	done
	if [[ -z "$profile_dir" ]]; then
		warn "no usable Firefox profile directory"
		return 0
	fi

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would theme Firefox profile $(basename "$profile_dir")"
		return 0
	fi

	# --- user.js: append a managed block, never rewrite the file ---
	local uj="$profile_dir/user.js"
	if [[ ! -f "$uj" ]]; then
		printf '// %s\n' "created by theme-switcher" >"$uj"
	fi

	local uj_tmp
	uj_tmp="$(mktemp)"
	awk '/^\/\/ theme-switcher:firefox:begin/ { skip = 1 }
	     !skip                    { print }
	     /^\/\/ theme-switcher:firefox:end/ { skip = 0 }' "$uj" >"$uj_tmp"
	# Drop trailing blank lines so the appended block does not accumulate
	# whitespace on every run.
	sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$uj_tmp" >"$uj_tmp.trim" && mv "$uj_tmp.trim" "$uj_tmp"
	{
		printf '\n// theme-switcher:firefox:begin -- generated, edits inside are overwritten\n'
		printf '// Required or Firefox ignores every colour in userChrome.css.\n'
		printf 'user_pref("ui.useCustomColors", true);\n'
		printf 'user_pref("browser.theme.content-theme", "dark");\n'
		printf 'user_pref("browser.display.background_color", "%s");\n' "$(c base)"
		# DNS-over-HTTPS OFF, so the /etc/hosts blocklist actually applies.
		#
		# This is not a theming concern but it lives here because user.js is the only
		# supported way to set these without hand-editing prefs.js, and this file is
		# already written on every theme switch. Do not remove it thinking it belongs
		# with the colours.
		#
		# mode 5 is Firefox's default: DoH preferred, used even when plain DNS works.
		# With it on, Firefox talks straight to its configured resolver and never asks
		# libc, so /etc/hosts is not consulted and the blocklist does nothing in the
		# browser. Mode 2 is "try DoH, fall back to system DNS" -- still bypasses
		# /etc/hosts whenever DoH answers, so it is not enough either.
		#
		# 5 here means "DoH completely disabled": system DNS only, which means
		# /etc/hosts wins. That is the only value that makes the blocklist effective.
		printf 'user_pref("network.trr.mode", 5);\n'
		# network.trr.uri is left alone deliberately: with mode 5 no DoH request is ever
		# made, so the endpoint is irrelevant, and setting it would only matter if
		# someone later re-enables DoH and expects the blocklist to still hold.
		printf '// theme-switcher:firefox:end\n'
	} >>"$uj_tmp"
	if cmp -s "$uj_tmp" "$uj"; then
		rm -f "$uj_tmp"
		log "  ${D}· firefox user.js (unchanged)${_c_off}"
	else
		cat "$uj_tmp" >"$uj"; rm -f "$uj_tmp"
		CHANGED+=("firefox user.js")
		log "  ${G}✓${_c_off} firefox user.js"
	fi

	# --- userChrome.css: generated, in a managed block ---
	emit_css_block "$profile_dir/userChrome.css" "theme-switcher:firefox" <<EOF
/* Firefox chrome colours. Requires ui.useCustomColors=true, set in user.js. */
@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

:root {
	/* surfaces */
	--frame-background: $(c bg0);
	--toolbar-bgcolor: $(c bg1);
	--toolbar-background: $(c bg1);
	--tab-selected-bgcolor: $(c bg1);
	--tab-selected-toolbar-bgcolor: $(c bg1);
	--lwt-accent-color: $(c accent);
	--lwt-accent-color-alt: $(c accent);
	--lwt-toolbarbutton-icon-fill-attention: $(c accent);

	/* text */
	--toolbar-color: $(c fg);
	--tab-selected-color: $(c fg);
	--tab-selected-text-color: $(c fg);
	--toolbar-field-color: $(c fg);
	--lwt-text-color: $(c fg);

	/* fields: urlbar and search */
	--toolbar-field-background-color: $(c bg2);
	--toolbar-field-border-color: $(c bg3);
	--toolbar-field-focus-background-color: $(c bg2);
	--toolbar-field-focus-color: $(c fg);
	--toolbar-field-focus-border-color: $(c accent2);
	--toolbar-field-placeholder-color: $(c fg2);
	--toolbar-field-separator-color: $(c bg3);

	/* inactive tabs and toolbar buttons */
	--tab-background: $(c bg0);
	--tab-color: $(c fg2);
	--tab-border-color: $(c bg2);
	--toolbarbutton-icon-fill: $(c fg2);
	--toolbarbutton-hover-background: $(c bg2);
	--toolbarbutton-active-background: $(c bg3);

	/* sidebars and panels */
	--sidebar-background: $(c bg1);
	--sidebar-text-color: $(c fg);
	--sidebar-border-color: $(c bg2);
	--lwt-sidebar-background: $(c bg1);
	--panel-disabled-color: $(c overlay0);
	--panel-separator-color: $(c bg3);

	/* popups, findbar, notifications */
	--arrowpanel-background: $(c bg2);
	--arrowpanel-border-color: $(c bg3);
	--arrowpanel-color: $(c fg);
	--findbar-background: $(c base);
	--findbar-text-color: $(c fg);
	--findbar-highlight: $(c accent);
	--popnotification-background: $(c bg2);
	--popnotification-border-color: $(c bg3);

	/* accents: checkboxes, radios, focus rings, selection */
	--checkbox-background-color: $(c bg2);
	--checkbox-border-color: $(c bg3);
	--checkbox-checked-border-color: $(c accent2);
	--checkbox-checked-background-color: $(c accent);
	--radio-selected-border-color: $(c accent2);
	--focus-outline-color: $(c accent2);
	--toolbarbutton-focus-ring-color: $(c accent2);
	--urlbar-separator-color: $(c bg3);

	/* bookmarks and misc */
	--toolbar-borders: $(c bg2);
	--lwt-box-border-color: $(c bg3);
	--button-bgcolor: $(c bg3);
	--button-hover-bgcolor: $(c accent);
	--button-color: $(c fg);
	--tab-line-color: $(c accent);
	--selected-tab-bgcolor: $(c bg1);
	--selected-tab-color: $(c fg);
	--newtab-background-color: $(c bg0);
	--newtab-text-primary-color: $(c fg);
	--newtab-text-secondary-color: $(c fg2);
}
EOF

	log "  ${G}✓${_c_off} firefox (profile: $(basename "$profile_dir"))"
}

# --- VS Code -------------------------------------------------------------
#
# No theme extension is installed, so this drives VS Code with the built-in
# "Dark Modern" plus workbench.colorCustomizations rather than a palette
# extension. That keeps it working with zero extra dependencies, and
# colorCustomizations is the same mechanism the Hyprland-Multi-Theme reference
# uses for its vsCodeExtraColors.
#
# settings.json is JSON *with comments* and belongs to the user, so it is never
# rewritten wholesale: the managed keys live between comment markers and only
# that block is replaced. Comments elsewhere in the file, and unrelated
# settings, survive. That is why this is not just `jq`.
render_vscode() {
	local f="$HOME/.config/Code/User/settings.json"

	if [[ ! -d "$(dirname "$f")" ]]; then
		warn "VS Code user dir not found, skipping"
		return 0
	fi

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would write VS Code colours to $(basename "$(dirname "$f")")/settings.json"
		return 0
	fi

	local rc=0 out pal
	# Hand the whole palette over as JSON so the helper does no parsing of its own.
	pal="$(jq -c '.colors' "$CURRENT_PALETTE_FILE")"
	out="$(VSCODE_THEME_FILE="$f" VSCODE_PALETTE="$pal" python3 <<'PYEOF'
import json, os, re, sys

path = os.environ["VSCODE_THEME_FILE"]
PALETTE = json.loads(os.environ["VSCODE_PALETTE"])
BEGIN = "// theme-switcher:vscode:begin"
END   = "// theme-switcher:vscode:end"

def c(role): return PALETTE[role]
def rgba8(role, a): return PALETTE[role] + "%02x" % round(a * 255)

colours = {
    "editor.background":                 c("bg0"),
    "editor.foreground":                 c("fg"),
    "editorCursor.foreground":           c("accent"),
    "editorLineNumber.foreground":       c("overlay0"),
    "editorLineNumber.activeForeground": c("fg2"),
    "editor.selectionBackground":        rgba8("accent", 0.25),
    "editor.inactiveSelectionBackground": rgba8("bg3", 0.55),
    "editorWhitespace.foreground":       c("bg3"),
    "editorIndentGuide.background1":     c("bg2"),
    "editorIndentGuide.activeBackground1": c("bg3"),
    "editorGutter.background":           c("bg0"),
    "editorError.foreground":            c("red"),
    "editorWarning.foreground":          c("yellow"),
