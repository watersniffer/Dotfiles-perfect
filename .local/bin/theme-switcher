# Dump the two managed keys, then unwrap: what goes between the markers has to
# be the *body* of the settings object, not a nested object of its own.
body = json.dumps({"workbench.colorTheme": "Dark Modern",
                   "workbench.colorCustomizations": colours},
                  indent=4).split("\n")
assert body[0] == "{" and body[-1] == "}", body[:1] + body[-1:]
body = body[1:-1]                       # drop the wrapper braces
body = [ln[4:] if ln.startswith("    ") else ln for ln in body]   # de-indent one level

# Strip any previous block, then splice the new one in just before the object's
# closing brace. Splicing text (not re-serialising the whole document) is what
# keeps the user's own comments and key order intact.
src = open(path).read() if os.path.exists(path) else "{}"
lines = src.split("\n")
out, skipping = [], False
for line in lines:
    if BEGIN in line:
        skipping = True
        continue
    if END in line:
        skipping = False
        continue
    if not skipping:
        out.append(line)

# drop trailing blank lines, then find the final closing brace
while out and not out[-1].strip():
    out.pop()

if not out or not out[-1].lstrip().startswith("}"):
    print("could not find the end of the settings object", file=sys.stderr)
    sys.exit(1)

# The final line is the object's own closing brace, so pop that first and only
# then decide whether the *property* above it needs a comma. Peeking the wrong
# way round appends a comma to the brace and produces an unparseable file.
closing = out.pop().rstrip()
prev = out.pop().rstrip() if out else ""   # popped too, or it is emitted twice
# Strip any trailing comma before adding one back. Without this the file gains a
# comma per run: the previous run left one on the last user property, and
# appending another unconditionally turns "open", into "open",,
needs_comma = prev.lstrip() not in ("", "{")
prev = prev.rstrip().rstrip(",").rstrip()

block = ["    " + BEGIN + " -- generated by theme-switcher, edits inside are overwritten"]
block += ["    " + ln if ln.strip() else ln for ln in body]
block += ["    " + END]

result = out + [prev + ("," if needs_comma else "")] + block + [closing]
open(path, "w").write("\n".join(result) + "\n")
print("ok")
PYEOF
)" || rc=$?

	if ((rc != 0)); then
		warn "VS Code settings rewrite failed"
		return 0
	fi

	CHANGED+=("VS Code settings.json")
	log "  ${G}✓${_c_off} VS Code settings.json"
}

# --- zsh ---------------------------------------------------------------
# ~/.zshrc is pointed at ~/.config/theme-switcher/zsh/<name>.zsh-theme by a
# single line added at install time; this just writes oh-my-zsh compatible
# prompt themes and the matching LS_COLORS.
render_zsh() {
	local name; name="$(jq -r '.name' "$CURRENT_PALETTE_FILE")"
	mkdir -p "$THEME_DIR/zsh/themes"

	# Link it where oh-my-zsh will actually look.
	#
	# OMZ appends ".zsh-theme" itself and searches only $ZSH_CUSTOM,
	# $ZSH_CUSTOM/themes and $ZSH/themes. It cannot be given a path. So the
	# generated file is linked in as theme-<name>.zsh-theme, and .zshrc sets
	# ZSH_THEME to the bare name "theme-<name>".
	#
	# The prefix also stops this clobbering OMZ's own themes -- there is already
	# a custom/themes/gruvbox.zsh-theme belonging to oh-my-zsh, and the gruvbox
	# palette generates a file of the same name.
	local omz_dir="$HOME/.oh-my-zsh/custom/themes"
	local link="$omz_dir/theme-$name.zsh-theme"
	local target="$THEME_DIR/zsh/themes/$name.zsh-theme"

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would link $link -> $target"
	else
		mkdir -p "$omz_dir"
		if [[ -L "$link" ]]; then
			if [[ "$(readlink "$link")" == "$target" ]]; then
				log "  ${D}· zsh omz link (unchanged)${_c_off}"
			else
				ln -sfn "$target" "$link" && log "  ${G}✓${_c_off} zsh omz link"
			fi
		elif [[ -e "$link" ]]; then
			warn "$link exists and is not a symlink; leaving it alone"
		else
			ln -sfn "$target" "$link" && {
				CHANGED+=("zsh omz link")
				log "  ${G}✓${_c_off} zsh omz link"
			}
		fi
	fi

	emit "zsh theme ($name)" "$target" <<EOF
# $THEME_LABEL -- generated by theme-switcher.
# oh-my-zsh prompt theme. ~/.zshrc points ZSH_THEME at
# ~/.oh-my-zsh/custom/themes/theme-$name.zsh-theme, which is a symlink to this
# file, because oh-my-zsh appends ".zsh-theme" itself and searches only its own
# theme directories -- it cannot be given a path.

# Plain assignments, deliberately not 'local': this file is sourced at the top
# level, outside any function, where local is not a function scope.
#
# The values are real ANSI escapes, not hex strings. A prompt cannot use
# "#rrggbb", and dropping one inside %{%...%} fails silently rather than
# loudly: %{%...%} marks its contents zero-width, so the hex digits are made
# invisible and the colour simply never appears.
c_fg=$(hex2ansi_zsh "$(c fg)")
c_accent=$(hex2ansi_zsh "$(c accent)")
c_blue=$(hex2ansi_zsh "$(c blue)")
c_red=$(hex2ansi_zsh "$(c red)")
c_green=$(hex2ansi_zsh "$(c green)")
c_yellow=$(hex2ansi_zsh "$(c yellow)")
c_dim=$(hex2ansi_zsh "$(c overlay0)")
c_off=$(hex2reset_zsh)

PROMPT='%{\$c_accent%}╭─%{\$c_dim%} [%{\$c_fg%}%n%{\$c_dim%}] [%{\$c_blue%}%~%{\$c_dim%}]%{\$c_accent%}'
PROMPT+='%(!.#%{\$c_green%}❯ .%{\$c_accent%}❯ )'
RPROMPT='%{\$c_dim%}[%{\$c_yellow%}%D{%H:%M}%{\$c_dim%}]%{\$c_accent%}╯%{\$c_off%}'
ZLE_RPROMPT_INDENT='  '

setopt promptsubst

_prompt_git() {
  if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
    local branch dirty
    branch=\$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    dirty=\$(git status --porcelain 2>/dev/null | head -1)
    printf ' %sgit:%s%s%s' "\$c_dim" "\$c_blue" "\$branch" "\$c_dim"
    [[ -n "\$dirty" ]] && printf '%s●%s' "\$c_red" "\$c_dim"
    printf ' %s' "\$c_off"
  fi
}

_prompt_status() {
  local code=\$?
  if (( code != 0 )); then
    RPROMPT="\${c_red}\${code}\${c_dim} %D{%H:%M}\${c_accent}╯\${c_off}"
  else
    RPROMPT="\${c_dim}%D{%H:%M}\${c_accent}╯\${c_off}"
  fi
  return \$code
}

# add-zsh-hook comes from oh-my-zsh. Guard it so the file can also be sourced
# directly (zsh -f, a test harness) without three "command not found" errors.
if (( \$+functions[add-zsh-hook] )); then
  add-zsh-hook precmd _prompt_git
  add-zsh-hook precmd _prompt_status
  add-zsh-hook preexec _prompt_status
fi
EOF

	# LS_COLORS with truecolour escapes, so `ls` matches the palette exactly
	# rather than being quantised to the nearest of 16 colours.
	local di ln ex pi so bd cd or_ mi ow tw su
	di="$(hex2truecolor "$(c blue)")"
	ln="$(hex2truecolor "$(c cyan)")"
	ex="$(hex2truecolor "$(c green)")"
	pi="$(hex2truecolor "$(c yellow)")"
	so="$(hex2truecolor "$(c magenta)")"
	bd="$(hex2truecolor "$(c yellow)")"
	cd="$(hex2truecolor "$(c yellow)")"
	or_="$(hex2truecolor "$(c red)")"
	mi="$(hex2truecolor "$(c red)")"
	ow="$(hex2truecolor "$(c fg2)")"
	tw="$(hex2truecolor "$(c accent)")"
	su="$(hex2truecolor "$(c accent)")"

	emit "zsh lscolors ($name)" "$THEME_DIR/zsh/lscolors.zsh" <<EOF
# $THEME_LABEL -- generated by theme-switcher.
# Sourced by ~/.zshrc. Rewritten per theme so \`ls\` and friends agree with the
# desktop instead of keeping whatever dircolors last wrote.

export LS_COLORS='di=$di:ln=$ln:ex=$ex:pi=$pi:so=$so:bd=$bd:cd=$cd:\
or=$or_:mi=$mi:ow=$ow:tw=$tw:st=$tw:su=$su:sg=$tw:ca=$tw:tu=$tw:'
EOF
}

# --- hyprlock ----------------------------------------------------------
# hyprlock.conf is a 180-line hand-written layout and 0.9.6 has no `source=`,
# so the nine colour literals are patched in place. Each key comes from the
# palette's `hyprlock` block rather than being derived, because the clock
# colour in particular is a per-theme design decision and gruvbox's existing
# values have to round-trip exactly.
render_hyprlock() {
	local f="$HOME/.config/hypr/hyprlock.conf"
	[[ -f "$f" ]] || { warn "hyprlock.conf not found, skipping"; return 0; }

	hk() { jq -r ".hyprlock.$1" "$CURRENT_PALETTE_FILE"; }
	[[ -n "$(hk clock)" && "$(hk clock)" != "null" ]] || {
		warn "palette has no hyprlock block, skipping"; return 0; }

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would recolour hyprlock.conf"
		return 0
	fi

	_hyprlock_recolour "$f"
}

# Recolour hyprlock.conf by position rather than by value.
#
# hyprlock 0.9.6 has no `source=`, and the file is a 180-line hand-written
# layout that is not worth regenerating, so the nine colour literals are patched
# in place. There are exactly nine, always in this order:
#
#   1 label time colour      2 label day-date colour   3 label user-icon colour
#   4 label user colour      5 input-field outer_color 6 input-field inner_color
#   7 input-field font_color 8 label song colour       9 placeholder foreground
#
# Matching on position rather than on the previous literal is what makes
# repeated switching correct: a value-based sed only knows how to replace the
# colours that happened to be there originally, so the second switch in any
# direction would silently do nothing.
_hyprlock_recolour() {
	local f="$1"
	hk() { jq -r ".hyprlock.$1" "$CURRENT_PALETTE_FILE"; }
	local -a want=(
		"$(hk clock)"      "$(hk date)"       "$(hk icon)"
		"$(hk user)"       "$(hk input_outer)" "$(hk input_inner)"
		"$(hk input_font)" "$(hk song)"
	)
	local placeholder; placeholder="$(hk placeholder_fg)"

	local tmp i
	tmp="$(mktemp)"
	i=0

	local line key
	while IFS= read -r line || [[ -n "$line" ]]; do
		if ((i < ${#want[@]})) &&
			[[ "$line" =~ ^([[:space:]]*)(color|outer_color|inner_color|font_color)([[:space:]]*=[[:space:]]*) ]]; then
			key="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
			printf '%s = %s\n' "$key" "${want[$i]}" >>"$tmp"
			i=$((i + 1))
			continue
		fi
		if [[ "$line" == *placeholder_text* ]]; then
			line="${line//foreground=\"#[0-9a-fA-F]*\"/foreground=\"$placeholder\"}"
		fi
		printf '%s\n' "$line" >>"$tmp"
	done <"$f"

	if ((i != ${#want[@]})); then
		rm -f "$tmp"
		warn "hyprlock.conf: expected ${#want[@]} colour keys, found $i -- left untouched"
		return 0
	fi

	# Always return 0: "no change" is a normal outcome here, and these renderers
	# run under `set -e`, so a 1 would abort the whole switch.
	if cmp -s "$tmp" "$f"; then
		rm -f "$tmp"
		log "  ${D}· hyprlock.conf (unchanged)${_c_off}"
		return 0
	fi
	cat "$tmp" >"$f"
	rm -f "$tmp"
	CHANGED+=("hyprlock.conf")
	log "  ${G}✓${_c_off} hyprlock.conf"
	return 0
}

# --- Wallpaper ------------------------------------------------------------
# Pick a random image from the active theme's wallpaper folder and hand it to
# awww.
#
# apps.wallpaper wins if it is set to a specific file, which keeps a theme
# pinned to one picture. Otherwise a random one is chosen from
# apps.wallpaper_dir, the same folder the Super+W picker offers.
#
# This is the one part of a switch that is deliberately NOT idempotent: a second
# run picks a second picture, which is the point. Everything else in this script
# skips unchanged work, so that one intentional exception is called out here.
apply_wallpaper() {
	local dir="${APP[wallpaper_dir]:-}"
	local pinned="${APP[wallpaper]:-}"
	local img

	if [[ -n "$pinned" && "$pinned" != "null" ]]; then
		img="${pinned/#\~/$HOME}"
		[[ -f "$img" ]] || { warn "palette wallpaper does not exist: $img"; return 0; }
		((DRY_RUN)) && { log "${_c_dim}dry-run${_c_off} would apply pinned wallpaper $img"; return 0; }
		if awww img --transition-type fade --transition-duration 1.5 -- "$img" 2>/dev/null; then
			log "  ${G}✓${_c_off} wallpaper -> $(basename "$img")"
		else
			warn "awww could not set the wallpaper"
		fi
		return 0
	fi

	[[ -n "$dir" ]] || return 0
	dir="${dir/#\~/$HOME}"

	if [[ ! -d "$dir" ]]; then
		warn "wallpaper folder does not exist: $dir"
		return 0
	fi

	# NUL-delimited, because a wallpaper folder is exactly the kind of place
	# that turns out to contain a file called "my holiday (2).jpg" or a stray
	# newline. A word-split find|shuf would pick the wrong thing or fail.
	local -a imgs=()
	mapfile -d '' -t imgs < <(
		find "$dir" -maxdepth 1 -type f \
			\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
			   -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.avif' \) \
			-print0 2>/dev/null | sort -z
	)

	if ((${#imgs[@]} == 0)); then
		warn "no images in $dir"
		return 0
	fi

	# Uniform pick. $RANDOM is seeded per process by bash, and drawing a fresh
	# one each run is what makes this a random wallpaper rather than a fixed one.
	img="${imgs[RANDOM % ${#imgs[@]}]}"

	((DRY_RUN)) && { log "${_c_dim}dry-run${_c_off} would apply a random wallpaper from ${#imgs[@]} in $dir"; return 0; }

	# a fade, so a theme switch reads as one deliberate event rather than a jump.
	if awww img --transition-type fade --transition-duration 1.5 -- "$img" 2>/dev/null; then
		log "  ${G}✓${_c_off} wallpaper -> $(basename "$img") ${_c_dim}(random of ${#imgs[@]})${_c_off}"
	else
		warn "awww could not set the wallpaper (is awww-daemon running?)"
	fi
}

# =============================================================== runtime ==

apply_gsettings() {
	local gt="${APP[gtk_theme]}" it="${APP[icon_theme]}"
	command -v gsettings >/dev/null 2>&1 || { warn "gsettings missing, skipping GTK runtime"; return 0; }

	if ((DRY_RUN)); then
		log "${_c_dim}dry-run${_c_off} would set GTK theme -> $gt, icons -> $it"
		return 0
	fi

	local before
	before="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || echo "''")"
	gsettings set org.gnome.desktop.interface gtk-theme "$gt" 2>/dev/null || true
	gsettings set org.gnome.desktop.interface icon-theme "$it" 2>/dev/null || true
	gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
	# gtk-application-prefer-dark-theme makes non-libadwaita GTK3 apps follow too.
	gsettings set org.gnome.desktop.interface gtk-application-prefer-dark-theme true 2>/dev/null || true

	if [[ "$before" != "'$gt'" ]]; then
		CHANGED+=("gsettings gtk-theme")
		log "  ${G}✓${_c_off} gsettings gtk-theme -> $gt"
	fi
	log "  ${D}· gsettings icon-theme -> $it${_c_off}"
}

# Report which Qt apps would need restarting, and restart them only if asked.
#
# Qt reads its palette once at startup and there is no way to recolour a running
# Qt process, so restarting is the only way to make it pick up a new theme.
#
# This is opt-in rather than automatic on purpose. An automatic kill here would
# take down Krita with unsaved work, or any other Qt app mid-edit, which is not
# something a theme switcher should ever do behind someone's back. By default the
# running apps are listed and the decision is left to the user.
list_qt_apps() {
	local -a pats=(
		whatsie kvantummanager kvantumstyleconfigurator qt6ct qt5ct
		krita gwenview kate kcalc okteta okular kateedit
	)
	local p pid found=()
	for p in "${pats[@]}"; do
		if pgrep -x "$p" >/dev/null 2>&1; then
			while read -r pid; do
				[[ -n "$pid" ]] && found+=("$p (pid $pid)")
			done < <(pgrep -x "$p" 2>/dev/null || true)
		fi
	done
	((${#found[@]})) || return 1
	printf '%s\n' "${found[@]}"
}

restart_qt_apps() {
	local -a pats=(
		whatsie kvantummanager kvantumstyleconfigurator qt6ct qt5ct
		krita gwenview kate kcalc okteta okular kateedit
	)
	local p pid
	for p in "${pats[@]}"; do
		while read -r pid; do
			[[ -n "$pid" ]] || continue
			if ((DRY_RUN)); then
				log "${_c_dim}dry-run${_c_off} would restart Qt app: $p (pid $pid)"
			else
				log "  ${Y}~${_c_off} restarting Qt app: $p (pid $pid) so it picks up the new palette"
				kill "$pid" 2>/dev/null || true
			fi
		done < <(pgrep -x "$p" 2>/dev/null || true)
	done
}

reload_apps() {
	if ((DRY_RUN)) || ((!RELOAD)); then
		((DRY_RUN)) && log "${_c_dim}dry-run${_c_off} skipping live reload"
		return 0
	fi

	# Hyprland: reload re-runs the Lua config, which re-dofiles theme.lua.
	# hl.on("hyprland.start") does not fire on reload, so autostart is untouched.
	#
	# `config-only` matters. A plain `hyprctl reload` also re-initialises the
	# monitors, which is by far the riskiest part of a reload -- outputs get torn
	# down and recreated, and if anything goes wrong there it takes the display
	# with it. A theme change only alters colours and never touches the monitor
	# block, so there is no reason to pay that risk. This is what keeps a theme
	# switch from being able to wedge the session the way monitor reloads can.
	if command -v hyprctl >/dev/null 2>&1; then
		if hyprctl reload config-only >/dev/null 2>&1; then
			log "  ${G}✓${_c_off} hyprctl reload config-only"
		elif hyprctl reload >/dev/null 2>&1; then
			log "  ${G}✓${_c_off} hyprctl reload (config-only unsupported)"
		else
			warn "hyprctl reload failed; borders keep the old colours until you reload"
		fi
	fi

	# Waybar: SIGUSR2 is the "reload" signal; SIGUSR1 is "toggle", which hides
	# the bar. Getting these the wrong way round looks exactly like the theme
	# switcher deleting the bar, which is how this was found.
	#
	# The bar re-reads style.css, which @imports colors.css, so this picks up
	# the new palette without a restart. reload_style_on_change is left alone in
	# the waybar config: it is the user's setting, and false is the cheaper one
	# to watch for.
	if pgrep -x waybar >/dev/null 2>&1; then
		pkill -SIGUSR2 -x waybar 2>/dev/null && log "  ${G}✓${_c_off} waybar (SIGUSR2, reload)" || true
	fi

	# Kitty: --configured makes it re-read the config, i.e. current-theme.conf.
	#
	# Every kitty process has its own listening socket (see ~/.local/bin/kitty),
	# so all of them are discovered from /proc/net/unix and addressed
	# individually. Targeting one fixed address would recolour one terminal and
	# leave the rest behind.
	#
	# The socket address has to be passed explicitly because this runs from a
	# keybind, not from inside a kitty window, so there is no KITTY_LISTEN_ON in
	# the environment for the client to pick up.
	if pgrep -x kitty >/dev/null 2>&1; then
		local me="${USER:-$(id -un)}" re hit=0
		re="@kitty-${me}-[0-9]+"
		local -a socks=()
		mapfile -t socks < <(
			awk -v re="$re" '
				$0 ~ re {
					# /proc/net/unix: "…: refcount flags type st inode path"
					for (i = 7; i <= NF; i++) { if ($i ~ /^@/) { print $i; break } }
				}
			' /proc/net/unix 2>/dev/null | sort -u
		)

		if ((${#socks[@]} == 0)); then
			warn "kitty is running but no listening socket was found; the open windows were started before the ~/.local/bin/kitty wrapper, so they keep their old colours until restarted"
		else
			for hit in "${socks[@]}"; do
				kitty @ --to "unix:$hit" set-colors --configured --all >/dev/null 2>&1 || true
			done
			hit=$((${#socks[@]}))
			log "  ${G}✓${_c_off} kitty (set-colors --configured --all, $hit socket(s))"
		fi
	fi

	# mako re-reads its config on SIGHUP.
	if pgrep -x mako >/dev/null 2>&1; then
		pkill -HUP -x mako 2>/dev/null && log "  ${G}✓${_c_off} mako (SIGHUP)" || true
	fi

	# swaync watches its stylesheet itself.
	if pgrep -x swaync >/dev/null 2>&1; then
		swaync-client --reload-css >/dev/null 2>&1 && log "  ${G}✓${_c_off} swaync (reload-css)" || true
	fi

	# wlogout only reads its css at startup.
	if pgrep -x wlogout >/dev/null 2>&1; then
		pkill -x wlogout 2>/dev/null && log "  ${G}✓${_c_off} wlogout (restarted to reload css)" || true
	fi

	# nwg-dock-hyprland likewise reads style.css only at startup, and there is no
	# signal for it (its runtime signals are visibility toggles, not a css reload), so
	# it has to be killed and started again.
	#
	# `pgrep -f` rather than -x: the process name is 17 characters, which is longer
	# than pgrep's 15-character match limit, so -x silently finds nothing and the
	# dock would keep the old colours forever.
	if pgrep -f 'nwg-dock-hyprland' >/dev/null 2>&1; then
		pkill -f 'nwg-dock-hyprland' 2>/dev/null
		sleep 0.4
		"$HOME/.local/bin/startup/nwg-dock.sh" >/dev/null 2>&1
		log "  ${G}✓${_c_off} nwg-dock (restarted to reload css)"
	fi
}

# =============================================================== picker ==

picker() {
	local -a names=() lines=()
	local cur; cur="$(current_theme)"
	local name label desc mark pick

	while IFS=$'\t' read -r name label desc; do
		names+=("$name")
		mark="  "
		[[ "$name" == "$cur" ]] && mark="● "
		lines+=("$mark$name   $label")
	done < <(list_themes)

	# One line per theme, and it has to be built with printf rather than
	# `"${lines[*]}"`: that joins the array with spaces into a single string, so
	# rofi receives one entry with all the themes glued together and only one
	# selectable row appears.
	pick="$(printf '%s\n' "${lines[@]}" | rofi -dmenu -i -p "theme" -lines 12)" || return 1

	# rofi hands back the whole line it drew, so the theme name has to be recovered
	# from it. Two steps, because a single clever expansion gets this wrong:
	#
	#   "${v#"${v%%[![:space:]]*}"}" is *not* an ltrim. It removes the
	#   contiguous non-space run at the front, so for "  monochrome   Monochrome"
	#   it strips the leading spaces correctly, but for "● gruvbox   Gruvbox Dark"
	#   it matches the marker instead and leaves "● gruvbox" untouched -- and
	#   "${v%% *}" then yields "●" as the theme name.
	#
	# Dropping the known marker explicitly and letting `read` do the whitespace
	# splitting handles every shape: with marker, without marker, marker
	# separated from the name by any amount of space, or the bare name.
	case "$pick" in
	"● "*) pick="${pick#● }" ;;
	esac

	local name _rest
	read -r name _rest <<<"$pick"
	printf '%s' "$name"
}

# =============================================================== preview ==

preview_theme() {
	local name="$1"
	load_palette "$(palette_path "$name")"
	banner "$THEME_LABEL" "$(theme_label "$(current_theme)")"
	printf '\n'
	printf '  base    %s   bg1    %s   bg2    %s   bg3    %s\n' \
		"$(c base)" "$(c bg1)" "$(c bg2)" "$(c bg3)"
	printf '  fg      %s   fg1    %s   fg2    %s\n' \
		"$(c fg)" "$(c fg1)" "$(c fg2)"
	printf '  accent  %s   accent2 %s\n' "$(c accent)" "$(c accent2)"
	printf '  red %s  green %s  yellow %s  blue %s\n' \
		"$(c red)" "$(c green)" "$(c yellow)" "$(c blue)"
	printf '  magenta %s  cyan %s  orange %s\n' \
		"$(c magenta)" "$(c cyan)" "$(c orange)"
	printf '  gtk      %s\n' "${APP[gtk_theme]}"
	printf '  icons    %s\n' "${APP[icon_theme]}"
	printf '  kvantum  %s\n' "${APP[kvantum_theme]}"
	printf '  nvim     %s\n' "${APP[nvim_colorscheme]}"
	printf '\n'
}

# =============================================================== main ==

usage() {
	cat >&2 <<EOF

  theme-switcher -- apply one palette across the whole session

  usage
    theme-switcher [theme]            apply a theme (no argument: rofi picker)
    theme-switcher --list             list installed themes
    theme-switcher --current          print the active theme
    theme-switcher --preview <theme>  show a palette without applying it

  options
    -n, --no-reload        write the configs but do not poke any running app
    -d, --dry-run          show what would be written, write nothing
        --restart-qt       also kill running Qt apps so they re-read the palette
        --no-wallpaper     skip the optional per-theme wallpaper
    -h, --help             this text

  notes
    Running Qt apps are listed after a switch but are NOT restarted. Qt reads
    its palette once at startup, so restarting is the only way to recolour one,
    and killing Krita with unsaved work is not this script's decision to make.
    Pass --restart-qt when you have nothing open.

EOF
}

main() {
	local target="" want_preview=0 do_wallpaper=1 restart_qt=0

	while (($#)); do
		case "$1" in
			-l|--list)     list_themes | column -t -s $'\t'; exit 0 ;;
			--current)     current_theme; exit 0 ;;
			--wallpaper-dir)
				# Which wallpaper folder belongs to the active theme.
				#
				# wallpaper-switcher calls this rather than reading the palette
				# itself, so the theme -> folder mapping lives in exactly one
				# place. Prints nothing and fails if the folder is missing, and
				# the caller falls back to the wallpapers root.
				load_palette "$(palette_path "$(current_theme)")"
				local wdir="${APP[wallpaper_dir]:-}"
				[[ -n "$wdir" ]] || exit 1
				wdir="${wdir/#\~/$HOME}"
				[[ -d "$wdir" ]] || exit 1
				printf '%s\n' "$wdir"
				exit 0
				;;
			-p|--preview)  want_preview=1; shift ;;
			-n|--no-reload) RELOAD=0; shift ;;
			-d|--dry-run)  DRY_RUN=1; shift ;;
			--restart-qt)  restart_qt=1; shift ;;
			--no-wallpaper) do_wallpaper=0; shift ;;
			-h|--help)     usage; exit 0 ;;
			-*)            error "unknown option: $1"; usage; exit 2 ;;
			*)             target="$1"; shift ;;
		esac
	done

	if ((want_preview)); then
		[[ -n "$target" ]] || die "--preview needs a theme name"
		theme_exists "$target" || die "no such theme: $target"
		preview_theme "$target"
		exit 0
	fi

	if [[ -z "$target" ]]; then
		command -v rofi >/dev/null 2>&1 || die "no theme given and rofi is not installed"
		target="$(picker)" || exit 0
		[[ -n "$target" ]] || exit 0
	fi

	theme_exists "$target" || {
		error "no such theme: $target"
		printf '  available:\n' >&2
		list_themes | while IFS=$'\t' read -r n l _; do printf '    %-18s %s\n' "$n" "$l" >&2; done
		exit 1
	}

	local previous; previous="$(current_theme)"
	local previous_label; previous_label="$(theme_label "$previous")"
	load_palette "$(palette_path "$target")"
	banner "$THEME_LABEL" "$previous_label"

	render_hypr
	render_waybar
	render_rofi
	render_kitty
	render_gtk
	render_qt
	render_mako
	render_swaync
	render_wlogout
	render_dock
	render_btop
	render_mpv
	render_nvim
	render_zsh
	render_hyprlock
	render_firefox
	render_vscode
	apply_gsettings

	if ((do_wallpaper)); then
		apply_wallpaper
	fi

	if ((DRY_RUN)); then
		printf '\n  %sDry run.%s Nothing was written. Re-run without --dry-run to apply.\n\n' "$Y" "$N" >&2
		exit 0
	fi

	# Record the active theme last, so an interrupted run does not claim a
	# theme that was only half applied.
	printf '%s\n' "$target" >"$THEME_DIR/current"

	((restart_qt)) && restart_qt_apps
	reload_apps

	printf '\n  %s%s applied.%s' "$G" "$THEME_LABEL" "$N" >&2
	if ((${#CHANGED[@]})); then
		printf ' %s(%d file(s) rewritten)%s' "$D" "${#CHANGED[@]}" "$N" >&2
	else
		printf ' %s(no files needed changing)%s' "$D" "$N" >&2
	fi
	printf '\n\n' >&2

	# Say what still needs the user's hand rather than doing it to them.
	local -a qt_running
	mapfile -t qt_running < <(list_qt_apps || true)
	if ((${#qt_running[@]})) && ((!restart_qt)); then
		log "${Y}still running with the old Qt palette, restart when convenient:${_c_off}"
		printf '    %s\n' "${qt_running[@]}" >&2
	fi

	log "open a new terminal, or run \`exec zsh\`, for the shell prompt to catch up"
}

main "$@"