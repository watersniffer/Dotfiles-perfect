hl("Operator",      fg1, { bold = true })
hl("PreProc",       acc)
hl("Type",          fg1)
hl("Structure",     fg)
hl("Special",       acc)
hl("SpecialChar",   fg1)
hl("Tag",           fg1)
hl("Delimiter",     fg2)
hl("Debug",         dim)

-- literals
hl("String",        fg1)
hl("Character",     fg1)
hl("Number",        fg1)
hl("Boolean",       fg1)
hl("Float",         fg1)
hl("Function",      fg)
hl("Label",         fg1)
hl("Keyword",       fg, { bold = true })
hl("Exception",     fg, { bold = true })
