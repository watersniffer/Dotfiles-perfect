#!/usr/bin/env bash
# Lock the session.
#
# Was `swaylock -C ~/.config/niri/lock.conf -f`. swaylock and swaylock-effects are
# uninstalled and hyprlock took over the Super+L bind, so calling swaylock here
# would only fail. The niri lock config went with it: hyprlock reads hyprlock.conf
# and has working defaults without one.
set -euo pipefail
exec hyprlock
